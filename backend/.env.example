# Backend Environment Configuration

PORT=4000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/agent_network?schema=public"
REDIS_URL="redis://localhost:6379"

# LLM Provider Configuration (Agnostic)
# Options: "auto" | "gemini" | "openai" | "anthropic" | "ollama" | "local"
LLM_PROVIDER=auto

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model: gemini-flash-latest (default) | gemini-2.5-flash | gemini-2.5-pro
# NOTE: gemini-1.5-* models are retired (404). Use flash-latest to stay current.
LLM_MODEL=gemini-flash-latest

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (Optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama / Local LLM (Optional)
# OLLAMA_BASE_URL=http://localhost:11434
